# ====================================================================
# Frontend (Flutter) Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit .env containing real tokens into version control!
# ====================================================================

# Production / Cloud Deployed Backend URL (optional, e.g. https://tripz-backend-1mm1.onrender.com)
# If set, this takes precedence over IP_ADDRESS.
BACKEND_URL=

# Backend Host IP Address (used when BACKEND_URL is not set)
# Use 'localhost' for Chrome/Web, or your machine's LAN IP (e.g. 192.168.1.X) for physical devices
IP_ADDRESS=localhost

# ABA Payway Merchant Name
ABA_MERCHANT_NAME=your_merchant_name

# Bakong Payment Credentials
# Account ID can be retail testnet (@bkrt) or live bank account (@aba)
BAKONG_ACCOUNT_ID=your_account_id@bank
BAKONG_MERCHANT_NAME=your_merchant_name
BAKONG_TOKEN=your_bakong_jwt_token
