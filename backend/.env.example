# ====================================================================
# Backend Environment Configuration Template
# Copy this file to .env and replace the placeholder values.
# DO NOT commit .env containing real secrets into version control!
# ====================================================================

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/bus_booking
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# Security / JWT
JWT_SECRET=your_base64_or_hex_jwt_secret_key_at_least_256_bits

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# ABA Payway Credentials
ABA_MERCHANT_ID=your_aba_merchant_id
ABA_API_KEY=your_aba_api_key
ABA_PUBLIC_KEY=your_aba_rsa_public_key
ABA_PRIVATE_KEY=your_aba_rsa_private_key
ABA_PAYWAY_URL=https://checkout-sandbox.payway.com.kh
ABA_PURCHASE_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
ABA_RETURN_URL=http://localhost:8080/payment/aba/return
ABA_CANCEL_URL=http://localhost:8080/payment/aba/cancel

# Bakong Payment Credentials
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_ACCOUNT_ID=your_account_id@bank
BAKONG_MERCHANT_NAME=your_merchant_name
BAKONG_MERCHANT_CITY=PHNOM PENH
BAKONG_EMAIL=your_email@example.com
BAKONG_TOKEN=your_bakong_jwt_token
